# ==============================================================================
# SentinelQA Environment Variables Template
# Copy this file to .env (or backend/.env) and configure the credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Server Settings
# ------------------------------------------------------------------------------
APP_ENVIRONMENT=local                  # Options: local, dev, prod
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=true
LOG_LEVEL=INFO                         # DEBUG, INFO, WARNING, ERROR

# ------------------------------------------------------------------------------
# 2. LLM Provider Configuration (LangChain & LiteLLM Integration)
# ------------------------------------------------------------------------------
# Main LLM Provider: openai, google_genai, litellm, etc.
DEFAULT_LLM_PROVIDER=litellm

# LiteLLM Proxy / Gateway Settings
LITELLM_API_BASE=https://gw.jppwl.asia/v1
LITELLM_API_KEY=your-litellm-api-key-here
DEFAULT_MODEL=gemini-2.5-pro

# Direct Google Gemini API (Alternative)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-pro

# Direct OpenAI API (Alternative)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# ------------------------------------------------------------------------------
# 3. LangChain Agent Settings
# ------------------------------------------------------------------------------
# Maximum self-healing reflection loops when compiling / running mvn test
AGENT_MAX_HEALING_ITERATIONS=3
AGENT_TEMPERATURE=0.1
AGENT_REQUEST_TIMEOUT_SECONDS=120

# Optional LangSmith Tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langchain-api-key-here
LANGCHAIN_PROJECT=sentinel-qa

# ------------------------------------------------------------------------------
# 4. GitHub & Version Control Integration
# ------------------------------------------------------------------------------
# GitHub Personal Access Token (PAT) with repo & workflow permissions
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
GIT_AUTHOR_NAME=SentinelQA Bot
GIT_AUTHOR_EMAIL=sentinel-qa-bot@users.noreply.github.com

# Workspace directory where target repos are cloned and tested
SANDBOX_WORKSPACE_DIR=/tmp/sentinelqa-workspace

# ------------------------------------------------------------------------------
# 5. Jira / Requirement Ingestion Settings (Optional)
# ------------------------------------------------------------------------------
JIRA_SERVER_URL=https://your-domain.atlassian.net
JIRA_USER_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token-here

# ------------------------------------------------------------------------------
# 6. Local Network & Proxy Settings (Optional)
# ------------------------------------------------------------------------------
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1
