# ==============================================================================
# SentinelQA (AutoTestAgent) - Environment Configuration Template
# Copy this file to .env and fill in your credentials.
# ==============================================================================

# Application Runtime
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# LLM Providers (LiteLLM / Gemini / OpenAI Gateway)
# Option 1: LiteLLM Gateway
LITELLM_API_BASE=https://gw.jppwl.asia/v1
LITELLM_API_KEY=your_litellm_api_key_here

# Option 2: Direct Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Option 3: Direct OpenAI Compatible API
OPENAI_API_KEY=your_openai_api_key_here

# Default Model Selection
DEFAULT_LLM_MODEL=gemini-2.5-pro

# LangChain & LangSmith Tracing (Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT=SentinelQA-Dev

# Agent Execution Constraints
MAX_HEALING_ITERATIONS=3
COMMAND_TIMEOUT_SECONDS=180
SANDBOX_TEMP_DIR=/tmp/sentinelqa/sandboxes

# GitHub Integration
GITHUB_TOKEN=your_github_personal_access_token_here

# Jira Integration (Optional)
JIRA_SERVER_URL=https://your-domain.atlassian.net
JIRA_USERNAME=your_email@example.com
JIRA_API_TOKEN=your_jira_api_token_here
